{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onmissionok.com/schemas/layout-composition-v1.json",
  "title": "ON MISSION Governed Layout Composition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experienceId",
    "name",
    "tokens",
    "components",
    "pages",
    "marketVariants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "experienceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 120
      }
    },
    "components": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "tokenRefs",
          "properties"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"
          },
          "type": {
            "enum": [
              "header",
              "footer",
              "hero",
              "section",
              "card",
              "button",
              "badge",
              "input",
              "table",
              "dialog",
              "navigation",
              "mission-list",
              "evidence-panel",
              "status-panel",
              "progress"
            ]
          },
          "tokenRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "uniqueItems": true
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ],
              "maxLength": 300
            }
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "componentIds",
          "responsive"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"
          },
          "kind": {
            "enum": [
              "public-homepage",
              "onboarding",
              "organization-setup",
              "executor-workspace",
              "mission-experience",
              "shared-components"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "componentIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "responsive": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mobile",
              "tablet",
              "desktop"
            ],
            "properties": {
              "mobile": {
                "type": "string",
                "maxLength": 100
              },
              "tablet": {
                "type": "string",
                "maxLength": 100
              },
              "desktop": {
                "type": "string",
                "maxLength": 100
              }
            }
          }
        }
      }
    },
    "marketVariants": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "marketCode",
          "pageId",
          "themeTokenRefs",
          "contentOverrides"
        ],
        "properties": {
          "marketCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{2,8})?$"
          },
          "pageId": {
            "type": "string"
          },
          "themeTokenRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contentOverrides": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "DRAFT",
            "VALIDATED",
            "AUTHORIZED",
            "PUBLISHED",
            "VERIFIED",
            "ROLLED_BACK"
          ]
        },
        "basedOnRelease": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "requiredControls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "consent",
              "authorization",
              "eligibility",
              "evidence",
              "recovery"
            ]
          },
          "minItems": 6,
          "maxItems": 6
        }
      }
    }
  }
}
