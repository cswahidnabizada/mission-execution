{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onmission://market-factory/market-package/1.0",
  "title": "ON Mission Market Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageType", "metadata", "country", "languages", "sectors", "policies", "content", "legal", "product", "governance"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "packageType": {"const": "market-package"},
    "metadata": {"type":"object","additionalProperties":false,"required":["id","name","version","productKey"],"properties":{"id":{"type":"string","minLength":1,"maxLength":160},"name":{"type":"string","minLength":1,"maxLength":120},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"productKey":{"type":"string","minLength":1,"maxLength":120}}},
    "country": {"type":"object","additionalProperties":false,"required":["iso","name"],"properties":{"iso":{"type":"string","pattern":"^[A-Z]{2}$"},"name":{"type":"string","minLength":1,"maxLength":120}}},
    "languages": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["code","name"],"properties":{"code":{"type":"string"},"name":{"type":"string"},"primary":{"type":"boolean"}}}},
    "sectors": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["code","name"],"properties":{"code":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"required":{"type":"boolean"}}}},
    "policies": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["code","name"],"properties":{"code":{"type":"string"},"name":{"type":"string"},"policyType":{"type":"string"},"scope":{"type":"string"},"configuration":{"type":"object"}}}},
    "content": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["code","name","body"],"properties":{"code":{"type":"string"},"name":{"type":"string"},"pageType":{"type":"string"},"languageCode":{"type":"string"},"body":{"type":"string"},"status":{"type":"string"}}}},
    "legal": {"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"key":{"type":"string"},"code":{"type":"string"},"title":{"type":"string"},"description":{"type":"string"},"sourceUrl":{"type":"string"},"required":{"type":"boolean"},"status":{"type":"string"}}}},
    "providers": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["code","name"],"properties":{"code":{"type":"string"},"name":{"type":"string"},"providerType":{"type":"string"},"countryCode":{"type":"string"},"regionCode":{"type":"string"}}}},
    "capabilities": {"type":"array","items":{"type":"string"}},
    "actions": {"type":"array","items":{"type":"string"}},
    "eligibility": {"type":"object"},
    "residency": {"type":"object"},
    "execution": {"type":"object"},
    "subscriptions": {"type":"array"},
    "billing": {"type":"array"},
    "product": {"type":"object","required":["productKey"],"properties":{"productKey":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"}}},
    "governance": {"type":"object","required":["jurisdiction","sectorPolicies","residency","retention"],"properties":{"jurisdiction":{"type":"object"},"sectorPolicies":{"type":"array","minItems":1},"residency":{"type":"object"},"retention":{"type":"array","minItems":5},"billing":{"type":"array"},"notifications":{"type":"array"}}},
    "certification": {"type":"object"},
    "dependencies": {"type":"object"}
  }
}
